# One LLM key enables real extraction. Without any key the app still runs, in
# offline mode: the full report layout renders with every financial field blank.
#
# The first provider with a key wins. Gemini is the default because its free
# tier needs no billing setup -- get a key at https://aistudio.google.com/apikey

GEMINI_API_KEY=

# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# GROQ_API_KEY=gsk_...
# OPENROUTER_API_KEY=sk-or-...

# ---------------------------------------------------------------------------
# Optional overrides
# ---------------------------------------------------------------------------

# Force a provider instead of auto-detecting:
#   gemini | anthropic | openai | groq | openrouter | ollama
# LLM_PROVIDER=gemini

# Override the model. Required for openai/groq/openrouter/ollama, which have no
# default -- e.g. LLM_MODEL=llama3.1:8b with LLM_PROVIDER=ollama.
# LLM_MODEL=gemini-2.5-flash

# Any OpenAI-compatible endpoint (overrides the provider's default base URL).
# LLM_BASE_URL=http://localhost:11434/v1

# LLM_MAX_TOKENS=32000
# GEMINI_THINKING_BUDGET=8192   # tokens reserved for reasoning, Gemini only
# ANTHROPIC_EFFORT=medium       # low | medium | high | xhigh | max

# ---------------------------------------------------------------------------
# Optional branding (see app/branding.py for the rest)
# ---------------------------------------------------------------------------
# BRAND_NAME=EQUIRESEARCH
# BRAND_TAGLINE=Independent Equity Insight
# BRAND_WEBSITE=www.example-research.com
